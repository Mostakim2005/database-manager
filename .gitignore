# Python
__pycache__/
*.py[cod]
*$py.class
*.sqlite
*.db

# Node / Web
node_modules/
dist/
.npm/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Temporary Archives & Logs
*.zip
*.tar.gz
*.log

# CI Logs & Reports
.ci-logs/
.ci-report/

# Media Sitemap XML Cache (large regenerated crawl dumps; keep catalog JSON committed)
data/media/sitemaps/*.xml
!data/media/sitemaps/.gitkeep

# GitHub Manager live full cache (contains private repo metadata; keep repos_public.json committed)
data/github/live_cache.json
data/github/sync_state.json
data/github/local_roots.json

# AI Manager live raw API/scrape cache (multi-MB transient dumps; keep models_master.* committed)
data/ai/live_cache/
