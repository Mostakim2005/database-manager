  "cross_domain_views": [
    {
      "name": "v_games_by_gpu",
      "domains": [
        "games",
        "pc"
      ],
      "description": "Maps PC games against candidate GPUs in the unified PC domain, PSU 550W safety, and BDT/USD prices."
    },
    {
      "name": "v_cpu_gpu_combos",
      "domains": [
        "pc"
      ],
      "description": "Combines desktop CPUs and GPUs from the unified PC catalog with 550W PSU transient spike safety and BDT upgrade costs."
    },
    {
      "name": "v_game_benchmarks_with_pc",
      "domains": [
        "games",
        "pc"
      ],
      "description": "Joins real-world Avg, 1% Low, and 0.1% Low FPS benchmarks against unified PC GPU/CPU specs, PSU safety, and retail pricing."
    },
    {
      "name": "v_domain_health",
      "domains": [
        "pc",
        "games",
        "ai",
        "media",
        "book",
        "phone",
