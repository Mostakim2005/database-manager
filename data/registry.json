    {
      "name": "v_local_ai_vram_fit",
      "domains": [
        "ai",
        "hardware"
      ],
      "description": "Matches open-weights AI models against GPU VRAM tiers for local inference planning."
    },
    {
      "name": "v_domain_health",
      "domains": [
        "ai",
        "games",
        "hardware",
        "cpus",
        "pc_components"
      ],
      "description": "Unifies freshness timestamps, checksums, and record counts across all domain databases."
    }
  ]
